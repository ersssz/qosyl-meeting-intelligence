MOCK_LLM=1
ALLOW_MOCK_FALLBACK=1
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANALYSIS_PROVIDER=gemini
TRANSCRIPTION_PROVIDER=gemini
AIRGAP_MODE=0
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_ASR_MODEL=medium
LOCAL_ASR_DEVICE=auto
LOCAL_ASR_COMPUTE_TYPE=int8_float16
AUDIO_MAX_BYTES=30000000
LLM_TIMEOUT_SECONDS=10
# Optional overrides; when omitted, limits follow GEMINI_MODEL (15/500 or 5/20).
# GEMINI_RPM_LIMIT=15
# GEMINI_RPD_LIMIT=500
DATABASE_PATH=data/audit.db
API_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
