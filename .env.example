MOCK_LLM=0
ALLOW_MOCK_FALLBACK=1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
ANALYSIS_PROVIDER=gemini
TRANSCRIPTION_PROVIDER=faster-whisper
AIRGAP_MODE=0
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_NUM_CTX=4096
LOCAL_LLM_NUM_PREDICT=2048
LOCAL_ASR_MODEL=small
LOCAL_ASR_DEVICE=auto
LOCAL_ASR_COMPUTE_TYPE=int8_float16
LOCAL_ASR_BEAM_SIZE=1
SEQUENTIAL_MODEL_LOADING=true
AUDIO_MAX_BYTES=30000000
LLM_TIMEOUT_SECONDS=60
# Optional overrides for the actual account quota shown by Google AI Studio.
# GEMINI_RPM_LIMIT=15
# GEMINI_RPD_LIMIT=500
DATABASE_PATH=data/audit.db
API_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
